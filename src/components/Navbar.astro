---
import "../styles/global.css";
import LanguagePicker from "./LanguagePicker.astro";

const locale = Astro.currentLocale || "en";

const navItems = {
  en: [
    { label: "Home", path: "/" },
    { label: "Projects", path: "/projects" },
    { label: "Photography", path: "/photos" },
    { label: "About", path: "/about" },
  ],
  ja: [
    { label: "ホーム", path: "/" },
    { label: "プロジェクト", path: "/projects" },
    { label: "写真", path: "/photos" },
    { label: "自己紹介", path: "/about" },
  ],
};

const links = navItems[locale as keyof typeof navItems] || navItems.en;

function getLocalizedUrl(path: string) {
  // Return standard path for default language ('en')
  if (locale === "en") return path;
  
  // Format '/ja' + path (handling root '/' correctly)
  return path === "/" ? `/${locale}` : `/${locale}${path}`;
}
---

<header id="site-header" class="site-header">
    <div class="site-name">Owen Turetzky</div>
    <div class="language-picker-wrapper">
        <LanguagePicker></LanguagePicker>
    </div>
</header>

<div id="nav-sentinel"></div>
<div id="nav-wrapper" class="nav-wrapper">
    <nav id="navbar" class="navbar">
        {links.map((link) => (
            <a href={getLocalizedUrl(link.path)}>{link.label}</a>
        ))}
    </nav>
</div>

<style>
    .site-header {
        display: flex;
        justify-content: center;
        padding: 2.5rem 1rem 3.5rem;
        background-color: darkslateblue;
    }

    .site-name {
        padding-top: 0.5rem;
        font-size: 2.2rem;
        font-family: CustomSans, sans-serif;
        font-weight: bold;
        color: #fff;
    }

    .language-picker-wrapper {
        position: absolute;
        top: 1rem;
        right: 1.5rem;
        z-index: 10;
    }

    #nav-sentinel {
        height: 0px;
    }

    .nav-wrapper {
        position: sticky;
        top: 0;
        z-index: 1000;
        overflow: hidden;
    }

    .navbar {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
        padding: max(0.8rem, env(safe-area-inset-top)) 0.5rem 1.2rem;
        background-color: darkslateblue;
        box-sizing: border-box;
        transition: transform 0.3s ease-in-out;
    }

    .navbar a {
        color: #fff;
        text-decoration: none;
        font-family: CustomSans, sans-serif;
        font-size: 1.1rem;
        transition: color 0.2s ease;
    }

    .navbar a:hover {
        color: #c9c9c9;
    }

    .navbar.hidden {
        transform: translateY(-100%);
    }
</style>

<script>
    function initNav() {
        const sentinel = document.getElementById("nav-sentinel");
        const navbar = document.getElementById("navbar");
        if (!sentinel || !navbar) return;

        let lastScrollY = window.scrollY;
        let stuck = false;

        // Fires exactly when the nav transitions between inline and stuck.
        const observer = new IntersectionObserver(([entry]) => {
            stuck = !entry.isIntersecting;
            if (!stuck) navbar.classList.remove("hidden");
        });
        observer.observe(sentinel);

        window.addEventListener(
            "scroll",
            () => {
                const y = window.scrollY;
                if (stuck) navbar.classList.toggle("hidden", y > lastScrollY);
                lastScrollY = y;
            },
            { passive: true },
        );

        window.addEventListener("mousemove", (e) => {
            if (stuck && e.clientY < 60) navbar.classList.remove("hidden");
        });
    }

    initNav();
    document.addEventListener("astro:after-swap", initNav);
</script>
