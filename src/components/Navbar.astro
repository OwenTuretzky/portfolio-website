---
import '../styles/global.css';
---
<div id="top-status-bar" />
<div id="nav-hover-trigger"/>

<header id="site-header">
    <div id="site-name">Owen Turetzky</div>
    <div id="nav-wrapper">
        <nav id="navbar-links">
            <a href="/">Home</a>
            <a href="/projects">Projects</a>
            <a href="/photos">Photography</a>
        </nav>
    </div>
</header>

<style>

    #top-status-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: env(safe-area-inset-top, 0px);
        background: #483d8b;
        z-index: 1002;
        pointer-events: none;
    }

    #nav-hover-trigger {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 40px;
        z-index: 1001;
    }

    #site-header {
        background: darkslateblue;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: calc(2.5rem + env(safe-area-inset-top, 0px));
        width: 100%;
    }
    
    #site-name {
        font-size: 2.2rem;
        font-family: CustomSans, sans-serif;
        font-weight: bold;
        color: #fff;
        margin-bottom: 3.5rem;
    }

    #nav-wrapper {
        width: 100%;
        height: 3.1rem;
    }

    #navbar-links {
        width: 100%;
        display: flex;
        justify-content: center;
        gap: 2rem;
        padding: 0.8rem 0 1.2rem 0;
        background: #483d8b;
        box-sizing: border-box;
        z-index: 1000;
    }

    #navbar-links a {
        color: #ffffff;
        text-decoration: none;
        font-family: CustomSans;
        font-size: 1.1rem;
        transition: color 0.2s ease;
    }

    #navbar-links a:hover {
        color: #c9c9c9;
    }

    #navbar-links.is-floating {
        position: fixed;
        top: 0; 
        left: 0;
        padding-top: calc(0.8rem + env(safe-area-inset-top, 0px));
        transform: translateY(-100%);
        transition: transform 0.25s ease;
    }

    #navbar-links.is-floating.is-visible {
        transform: translateY(0);
    }

</style>

<script>
    let lastY = window.scrollY;
    const nav = document.getElementById('navbar-links');
    const wrapper = document.getElementById('nav-wrapper');
    const trig = document.getElementById('nav-hover-trigger');

    window.addEventListener('scroll', () => {
        if (!nav || !wrapper) return;
        const y = window.scrollY;
        const isScrollingUp = y < lastY;
        
        const threshold = wrapper.offsetTop;

        if (y > threshold) {
            nav.classList.add('is-floating');
            nav.classList.toggle('is-visible', isScrollingUp);
        } else {
            nav.classList.remove('is-floating', 'is-visible');
        }
        lastY = y;
    }, { passive: true });

    trig?.addEventListener('mouseenter', () => {
        if (wrapper && window.scrollY > wrapper.offsetTop) {
            nav?.classList.add('is-visible');
        }
    });

    nav?.addEventListener('mouseleave', () => {
        if (wrapper && window.scrollY > wrapper.offsetTop) {
            nav?.classList.remove('is-visible');
        }
    });
</script>