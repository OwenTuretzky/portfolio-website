---
import BaseLayout from '../layouts/baseLayout.astro';
import '../styles/global.css';
---
<BaseLayout
    title="Projects | Owen Turetzky"
	description="My Computer Science Projects."
>
    <div class="main-container">
        <h1>Computer Science</h1>
        <p>This page is still being worked on, check out my <a href="https://github.com/OwenTuretzky" target="_blank" rel="noopener noreferrer">github</a> for now</p>
    </div>
    
</BaseLayout>

<style>

    .main-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 2rem;
    }

    h1 {
        font-family: CustomSans;
        font-weight: bold;
        font-size: 4rem;
    }

    p {
        font-family: CustomSans;
        font-size: 2rem;
        color: #888;
    }

    a {
        color: #888;
    }

</style>
